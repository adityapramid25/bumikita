# OPENROUTER_API_KEY: OpenRouter API key for Qwen 2.5-VL vision model
OPENROUTER_API_KEY=

# CUSTOM_AI_API_KEY / ECO_AI_API_KEY: Custom API Key for AI service
CUSTOM_AI_API_KEY=
ECO_AI_API_KEY=

# GEMINI_API_KEY: Default Gemini API Key (fallback)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# NEXT_PUBLIC_SUPABASE_URL: Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY: Your Supabase anon / public API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: Optional backend service role key for admin tasks
SUPABASE_SERVICE_ROLE_KEY=

